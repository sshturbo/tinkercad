{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CircuitLab Offline",
  "version": "0.1.5",
  "identifier": "dev.circuitlab.offline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "title": "CircuitLab Offline", "width": 1440, "height": 850, "minWidth": 960, "minHeight": 650 }] },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
